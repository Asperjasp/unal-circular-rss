CREATE TABLE institutions (
	id INTEGER NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	unique_hash VARCHAR(64) NOT NULL, 
	institution_type VARCHAR(50), 
	specialty_type VARCHAR(100), 
	registration_number VARCHAR(50), 
	nit VARCHAR(20), 
	address VARCHAR(500), 
	city VARCHAR(100), 
	department VARCHAR(100), 
	latitude FLOAT, 
	longitude FLOAT, 
	phone VARCHAR(50), 
	email VARCHAR(255), 
	website VARCHAR(500), 
	affiliation VARCHAR(255), 
	legal_representative VARCHAR(255), 
	medical_director VARCHAR(255), 
	services JSON, 
	specialties JSON, 
	treatments JSON, 
	certification_level VARCHAR(100), 
	accreditations JSON, 
	bed_capacity INTEGER, 
	employee_count INTEGER, 
	has_it_team BOOLEAN, 
	it_department_name VARCHAR(255), 
	technology_stack JSON, 
	data_quality_score FLOAT, 
	source_url VARCHAR(1000), 
	scraped_at DATETIME, 
	updated_at DATETIME, 
	PRIMARY KEY (id), 
	UNIQUE (nit)
)



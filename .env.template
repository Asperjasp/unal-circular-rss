# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    SCRAPPER SALUD - CONFIGURACIÓN                         ║
# ║                        AiMedic Health Scraper                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# Copia este archivo a .env y completa con tus valores reales
# Nunca compartas tu archivo .env, mantén tus API keys seguras

# ═══════════════════════════════════════════════════════════════════════════
# 🏢 TU INFORMACIÓN (Para personalizar mensajes de outreach)
# ═══════════════════════════════════════════════════════════════════════════
BUSINESS_NAME=AiMedic
BUSINESS_DESCRIPTION=Empresa de salud digital que provee soluciones de IA para hospitales y clínicas en Colombia
YOUR_NAME=Tu Nombre Aquí
YOUR_ROLE=CEO / Founder / Business Development

# ═══════════════════════════════════════════════════════════════════════════
# 🔧 CONFIGURACIÓN GENERAL
# ═══════════════════════════════════════════════════════════════════════════
SCRAPER_MODE=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=tu-api-key-segura-aqui-123456

# ═══════════════════════════════════════════════════════════════════════════
# 💾 BASE DE DATOS
# ═══════════════════════════════════════════════════════════════════════════
# SQLite (local): sqlite:///health_institutions.db
# PostgreSQL (producción): postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///health_institutions.db

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 SCRAPING / SELENIUM
# ═══════════════════════════════════════════════════════════════════════════
HEADLESS_MODE=True
SELENIUM_TIMEOUT=30
RATE_LIMIT_DELAY=2
LINKEDIN_ENABLED=True
TWITTER_ENABLED=True

# ═══════════════════════════════════════════════════════════════════════════
# 🤖 INTELIGENCIA ARTIFICIAL (CORE - OBLIGATORIAS)
# ═══════════════════════════════════════════════════════════════════════════

# ── Google Gemini AI ─────────────────────────────────────────────────────
# 📍 Obtener en: https://aistudio.google.com/apikey
# 💡 Uso: Redacción de mensajes personalizados, análisis de imágenes
# 💰 Costo: GRATIS hasta 15 req/min (Gemini 1.5 Flash)
GOOGLE_AI_STUDIO=AIzaSy...tu-key-aqui
VISION_MODEL=gemini-1.5-flash

# ── Perplexity AI ────────────────────────────────────────────────────────
# 📍 Obtener en: https://www.perplexity.ai/settings/api
# 💡 Uso: Investigación de personas, enriquecimiento de datos corporativos
# 💰 Costo: ~$5-20/mes (modelo sonar-pro)
PERPLEXITY_API_KEY=pplx-...tu-key-aqui

# ── Anthropic Claude ─────────────────────────────────────────────────────
# 📍 Obtener en: https://console.anthropic.com/settings/keys
# 💡 Uso: Generación de mensajes LinkedIn M1/M2/M3 y emails de outreach
# 💰 Costo: ~$0.003/1K tokens (claude-sonnet-4-20250514)
ANTHROPIC_API_KEY=sk-ant-...tu-key-aqui

# ── Prospect Intel — Ventana de contexto global Perplexity ───────────────
# 💡 Se envía en TODAS las búsquedas de prospección con Perplexity.
#    Úsala para definir el foco de búsqueda global.
PERPLEXITY_CONTEXT_WINDOW=Solo instituciones de salud colombianas. Foco en CIO, CTO, Gerente de Sistemas, Director TI.

# ═══════════════════════════════════════════════════════════════════════════
# 📊 CRM & VENTAS
# ═══════════════════════════════════════════════════════════════════════════

# ── HubSpot CRM ──────────────────────────────────────────────────────────
# 📍 Configuración:
#    1. Ve a: HubSpot → Settings → Integrations → Private Apps
#    2. Crea una "Private App" con estos permisos (scopes):
#       ✓ crm.objects.companies.read
#       ✓ crm.objects.companies.write
#       ✓ crm.objects.contacts.read
#       ✓ crm.objects.contacts.write
#       ✓ crm.objects.deals.read
#       ✓ crm.objects.deals.write
#    3. Copia el "Access Token"
# 💰 Costo: GRATIS (plan gratuito de HubSpot disponible)
HUBSPOT_ACCESS_TOKEN=pat-na1-...tu-token-aqui

# ═══════════════════════════════════════════════════════════════════════════
# 📋 GESTIÓN DE PROYECTOS
# ═══════════════════════════════════════════════════════════════════════════

# ── Linear (Project Management) ──────────────────────────────────────────
# 📍 Configuración:
#    1. Ve a: Linear → Settings → API → Personal API Keys
#    2. Crea un nuevo "Personal API Key"
#    3. (Opcional) Copia tu Team ID desde Linear → Settings → Teams
# 💰 Costo: GRATIS para equipos pequeños (<10 usuarios)
LINEAR_API_KEY=lin_api_...tu-key-aqui
LINEAR_DEFAULT_TEAM_ID=

# ═══════════════════════════════════════════════════════════════════════════
# 📧 EMAIL AUTOMATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Zoho Mail ────────────────────────────────────────────────────────────
# 📍 Configuración:
#    1. Ve a: https://api-console.zoho.com/
#    2. Crea "Self Client" o "Server-based Application"
#    3. Genera OAuth tokens con estos scopes:
#       ✓ ZohoMail.messages.ALL
#       ✓ ZohoMail.accounts.READ
#    4. Para obtener REFRESH_TOKEN, sigue el flujo OAuth2
#    5. ACCOUNT_ID lo encuentras en Zoho Mail → Settings → Account
# 💰 Costo: Según plan de Zoho Mail (desde $1/usuario/mes)
ZOHO_CLIENT_ID=1000...tu-client-id
ZOHO_CLIENT_SECRET=...tu-client-secret
ZOHO_REFRESH_TOKEN=1000...tu-refresh-token
ZOHO_ACCOUNT_ID=tu-account-id
ZOHO_FROM_EMAIL=tu-email@tudominio.com
ZOHO_DOMAIN=zoho.com

# ═══════════════════════════════════════════════════════════════════════════
# 📅 CALENDARIO
# ═══════════════════════════════════════════════════════════════════════════

# ── Google Calendar ──────────────────────────────────────────────────────
# 📍 Opción A - Service Account (RECOMENDADO para servidores):
#    1. Google Cloud Console → IAM & Admin → Service Accounts
#    2. Crea nueva Service Account
#    3. Descarga JSON key y guárdalo como "google_service_account.json"
#    4. Comparte tu calendario con el email de la service account
#
# 📍 Opción B - OAuth2 (para desarrollo local):
#    1. Google Cloud Console → APIs & Services → Credentials
#    2. Crea "OAuth 2.0 Client ID" tipo "Desktop app"
#    3. Descarga como "credentials.json"
# 💰 Costo: GRATIS (parte de Google Workspace)
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
GOOGLE_CREDENTIALS_FILE=

# ═══════════════════════════════════════════════════════════════════════════
# ⚙️ CONFIGURACIÓN AVANZADA (Opcional)
# ═══════════════════════════════════════════════════════════════════════════
PIPELINE_AUTO_SNAPSHOT=True
CONNECT_API_ENABLED=True


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    SCRAPPER SALUD - CONFIGURACIÓN                         ║
# ║                        AiMedic Health Scraper                             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝
#
# 📖 GUÍA COMPLETA: Lee GUIA_CONFIGURACION.md para instrucciones detalladas
# 🔧 SETUP RÁPIDO: Copia este archivo a .env y completa tus API keys

# ═══════════════════════════════════════════════════════════════════════════
# 🏢 TU INFORMACIÓN (Para personalizar mensajes de outreach)
# ═══════════════════════════════════════════════════════════════════════════
BUSINESS_NAME=AiMedic
BUSINESS_DESCRIPTION=Empresa de salud digital que provee soluciones de IA para hospitales y clínicas en Colombia
YOUR_NAME=
YOUR_ROLE=

# ═══════════════════════════════════════════════════════════════════════════
# 🔧 CONFIGURACIÓN GENERAL
# ═══════════════════════════════════════════════════════════════════════════
SCRAPER_MODE=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-api-key-here

# ═══════════════════════════════════════════════════════════════════════════
# 💾 BASE DE DATOS
# ═══════════════════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///health_institutions.db

# ═══════════════════════════════════════════════════════════════════════════
# 🌐 SCRAPING / SELENIUM
# ═══════════════════════════════════════════════════════════════════════════
HEADLESS_MODE=True
SELENIUM_TIMEOUT=30
RATE_LIMIT_DELAY=2
LINKEDIN_ENABLED=True
TWITTER_ENABLED=True

# ═══════════════════════════════════════════════════════════════════════════
# 🤖 INTELIGENCIA ARTIFICIAL (CORE - OBLIGATORIAS)
# ═══════════════════════════════════════════════════════════════════════════

# ── Google Gemini AI ─────────────────────────────────────────────────────
# 📍 https://aistudio.google.com/apikey
# 💰 GRATIS (15 req/min)
GOOGLE_AI_STUDIO=
VISION_MODEL=gemini-1.5-flash

# ── Perplexity AI ────────────────────────────────────────────────────────
# 📍 https://www.perplexity.ai/settings/api
# 💰 ~$5-20/mes
PERPLEXITY_API_KEY=

# ── Anthropic Claude (Generación M1/M2/M3 LinkedIn + Email outreach) ──────
# 📍 https://console.anthropic.com/settings/keys
# 💰 ~$0.003/1K tokens (claude-sonnet-4)
ANTHROPIC_API_KEY=

# ── Prospect Intel — Ventana de contexto global Perplexity ───────────────
# Se incluye en TODAS las búsquedas de prospección. Úsala para:
# - Filtrar por tipo de institución, ciudad, tamaño
# - Especificar qué cargos buscar
# - Excluir lo que no quieres
PERPLEXITY_CONTEXT_WINDOW=Solo instituciones de salud colombianas. Foco en CIO, CTO, Gerente TI.

# ═══════════════════════════════════════════════════════════════════════════
# 📊 CRM & VENTAS
# ═══════════════════════════════════════════════════════════════════════════

# ── HubSpot CRM ──────────────────────────────────────────────────────────
# 📍 HubSpot → Settings → Integrations → Private Apps
# 💰 GRATIS
# Scopes: crm.objects.{companies,contacts,deals}.read/write
HUBSPOT_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# 📋 GESTIÓN DE PROYECTOS
# ═══════════════════════════════════════════════════════════════════════════

# ── Linear ───────────────────────────────────────────────────────────────
# 📍 Linear → Settings → API → Personal API Keys
# 💰 GRATIS para equipos pequeños
LINEAR_API_KEY=
LINEAR_DEFAULT_TEAM_ID=

# ═══════════════════════════════════════════════════════════════════════════
# 📧 EMAIL AUTOMATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Zoho Mail ────────────────────────────────────────────────────────────
# 📍 https://api-console.zoho.com/
# 💰 Desde $1/usuario/mes
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=
ZOHO_DOMAIN=zoho.com

# ═══════════════════════════════════════════════════════════════════════════
# 📅 CALENDARIO
# ═══════════════════════════════════════════════════════════════════════════

# ── Google Calendar ──────────────────────────────────────────────────────
# 📍 Google Cloud Console → Service Accounts
# 💰 GRATIS
GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
GOOGLE_CREDENTIALS_FILE=

# ═══════════════════════════════════════════════════════════════════════════
# ⚙️ CONFIGURACIÓN AVANZADA
# ═══════════════════════════════════════════════════════════════════════════
PIPELINE_AUTO_SNAPSHOT=True
CONNECT_API_ENABLED=True
